# ======================================================================
# LIMS LRARVY — configuration (modèle)
# Copier ce fichier en « .env » dans le dossier backend/, puis l'adapter.
# Le fichier .env contient des secrets : ne pas le diffuser, ne pas le joindre
# à un courriel ; le sauvegarder avec la procédure d'installation.
# Une variable d'environnement Windows de même nom l'emporte sur ce fichier.
# ======================================================================

# Environnement : production | demo | test | developpement (ou local)
#   production : démarrage refusé si SECRET_KEY est la valeur par défaut
#   demo       : démonstration en ligne (Render + Neon, données fictives) ; même refus
#   test       : bandeau « Environnement de test » dans l'interface
ENVIRONNEMENT=production

# Base PostgreSQL : postgresql+asyncpg://utilisateur:motdepasse@hote:port/base
# Une chaîne Neon (postgresql://…?sslmode=require&channel_binding=require) se colle telle quelle.
DATABASE_URL=postgresql+asyncpg://postgres:MOT_DE_PASSE@localhost:5432/labo

# Clé de signature des cookies de session (au moins 32 caractères, aléatoire).
# La générer avec :  python -c "import secrets; print(secrets.token_urlsafe(48))"
# La changer déconnecte tous les utilisateurs.
SECRET_KEY=

# --- Sessions ---
# Durée maximale d'une session, en secondes (8 h)
SESSION_MAX_AGE=28800
# Déconnexion après N minutes sans activité
SESSION_INACTIVITE_MIN=30
# 1 quand l'application est servie en HTTPS (cookie « Secure », voir docs/https.md)
SESSION_HTTPS=0
# Origines autorisées en plus de l'hôte lui-même (protection CSRF), séparées par des virgules
ORIGINES_AUTORISEES=http://localhost:5173,http://127.0.0.1:5173
# Démonstration en ligne seulement : origines du front autorisées par CORS (sans chemin),
# ex. https://utilisateur.github.io ; vide sur le serveur local
CORS_ORIGINS=
# Jeton Authorization: Bearer (front sur un autre site) : validité en minutes, renouvelé pendant
# l'activité ; vide = SESSION_INACTIVITE_MIN
# JETON_DUREE_MIN=30

# --- Comptes ---
# Verrouillage après N échecs de connexion consécutifs, pendant M minutes
VERROU_ECHECS=5
VERROU_MINUTES=15

# --- Règles du laboratoire ---
# 0 pour suspendre le contrôle des habilitations (saisie initiale de la matrice)
HABILITATIONS_OBLIGATOIRES=1
# Site d'essai imprimé sur les rapports
SITE_ESSAI=LRAR Tanger
# Format des étiquettes (mm)
ETIQUETTE_LARGEUR_MM=50
ETIQUETTE_HAUTEUR_MM=25

# --- Dossiers ---
# Journaux applicatifs (un fichier par jour) et durée de conservation
LOG_DIR=D:\LIMS\logs
LOG_RETENTION_JOURS=90
# Dossier des sauvegardes de scripts\sauvegarde.ps1 (état affiché par /api/health)
SAUVEGARDE_DIR=D:\Sauvegardes\labo
